# ===== Aplicação =====
APP_NAME="CR2FA Lab"
APP_URL="http://localhost:3000"

# Segredo para assinar a sessão (JWT). Gere com: openssl rand -base64 48
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Caminho do banco SQLite
DATABASE_PATH="./data/cr2fa.db"

# ===== Admin inicial (usado por `npm run seed`) =====
# Se ADMIN_INITIAL_PASSWORD ficar vazio, o seed gera uma senha aleatória e mostra uma única vez no terminal.
# Em qualquer caso a troca da senha é obrigatória no primeiro acesso.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_NAME="Administrador"
ADMIN_INITIAL_PASSWORD=""

# ===== Planos (valores em BRL) =====
PRO_PRICE_BRL_MONTHLY="49.90"
PRO_PRICE_BRL_YEARLY="499.90"

# ===== Mercado Pago (Pix + cartão de crédito) =====
# Crie as credenciais em https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo do webhook (painel do Mercado Pago > Webhooks > Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=""

# ===== Pagamento em cripto =====
# Informe apenas os endereços que você quer aceitar. Redes sem endereço ficam desativadas.
# Endereço EVM (o mesmo serve para Ethereum, Arbitrum, Base, Polygon, Optimism etc.)
CRYPTO_EVM_ADDRESS=""
CRYPTO_BTC_ADDRESS=""
CRYPTO_SOL_ADDRESS=""

# RPCs (troque por provedores próprios para mais estabilidade)
RPC_ETHEREUM="https://ethereum-rpc.publicnode.com"
RPC_ARBITRUM="https://arbitrum-one-rpc.publicnode.com"
RPC_BASE="https://base-rpc.publicnode.com"
RPC_POLYGON="https://polygon-bor-rpc.publicnode.com"
RPC_OPTIMISM="https://optimism-rpc.publicnode.com"
RPC_SOLANA="https://api.mainnet-beta.solana.com"
BTC_API="https://mempool.space/api"

# Cotação usada para converter BRL em cripto (CoinGecko). Chave opcional.
COINGECKO_API_KEY=""

# ===== E-mail (recuperação de senha) =====
# Crie a conta em https://resend.com, verifique o domínio e gere a chave de API.
# MAIL_FROM precisa ser um endereço do domínio verificado.
RESEND_API_KEY=""
MAIL_FROM="NIZA INVEST <contato@nizainvest.com.br>"

# ===== Dados de mercado =====
# brapi.dev (ações e FIIs brasileiros). Token gratuito em https://brapi.dev
BRAPI_TOKEN=""
