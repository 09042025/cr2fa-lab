{
  "expo": {
    "name": "NIZA INVEST",
    "slug": "niza-invest",
    "scheme": "nizainvest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1a4a",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita a câmera para gravar Cashpills e stories em vídeo.",
          "microphonePermission": "Permita o microfone para gravar o som dos seus vídeos.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para enviar imagens na comunidade."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.nizainvest.app"
    },
    "android": {
      "package": "br.com.nizainvest.app",
      "adaptiveIcon": {
        "backgroundColor": "#070d1c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}